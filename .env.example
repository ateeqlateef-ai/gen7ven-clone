# =============================================================================
# Novexa Solutions - Environment Configuration & Secrets
# =============================================================================
# Add these variables in AI Studio Settings -> Secrets / Environment Variables
# Do NOT commit actual passwords or sensitive credentials to version control.
# =============================================================================

# SMTP Server Configuration (for sending contact form inquiries to contact@novexasolutions.uk)
# Examples:
# - Hostinger / Titan / cPanel: smtp.hostinger.com / smtp.titan.email (Port 465)
# - Google Workspace / Gmail: smtp.gmail.com (Port 465 or 587, requires an App Password)
# - Microsoft 365 / Outlook: smtp.office365.com (Port 587)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@novexasolutions.uk
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="Novexa Solutions Inquiries" <contact@novexasolutions.uk>

# Destination email where customer inquiries will be delivered (defaults to contact@novexasolutions.uk)
CONTACT_RECIPIENT_EMAIL=contact@novexasolutions.uk

# Gemini API Key (optional - for server-side AI integrations)
GEMINI_API_KEY=
